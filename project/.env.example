# Copy this file to .env and fill in your values.
# Never commit your .env file — it is listed in .gitignore.

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your-gcp-project-id-wildfire-data-lake
BQ_DATASET=wildfire_data

# Path to your GCP service account JSON key file (absolute path on your machine)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-key.json

# Kaggle API credentials (from https://www.kaggle.com/settings)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
